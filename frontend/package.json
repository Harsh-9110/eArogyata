{
  "name": "e-arogyata-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:api": "node ../scripts/generate-api.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:api && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "build:vercel": "npm run typecheck && vite build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2"
  }
}
